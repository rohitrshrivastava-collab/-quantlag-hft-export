CS_RATE_LIMIT_DEFAULT_PER_MIN=60
LAGGARD_STALE_AFTER_S=10
LIVE_ORDER_TIMEOUT_S=5.0

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
